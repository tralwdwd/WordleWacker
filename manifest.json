{
    "manifest_version": 3,
    "name": "WordleWacker",
    "description": "Solve wordle easily",
    "version": "1.0",
    "content_scripts": [{
      "matches":["https://www.nytimes.com/games/wordle/index.html"],  
      "js": ["inject.js"]
      }],
      "permissions": [
    "storage"
      ]
